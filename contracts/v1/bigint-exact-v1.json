    "rem": "BigInt.rem has the dividend sign and satisfies a == quot(a,b)*b + rem(a,b)",
    "div_rem": "BigInt.div_rem returns the same quotient/remainder pair in one operation",
    "slash": "The / operator is not an implicit truncating BigInt quotient. Use a named exact-domain operation or an explicitly selected Decimal/Rational conversion.",
