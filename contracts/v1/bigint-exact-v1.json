    "canonical_text": "base-10 ASCII; zero is 0; no leading +; no redundant leading zeros; negative zero canonicalizes to 0",
    "resource_policy": "bit length, decimal digit count, exponent/shift, output allocation and work are bounded before catastrophic allocation; arbitrary precision is outside hard-RT unless WCET and memory are statically bounded"
  },
