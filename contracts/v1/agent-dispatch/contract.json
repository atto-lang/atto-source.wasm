{
  "contract": "oreslang.agent_model_dispatch.host_gate.v1",
  "contract_version": 1,
  "classification": "HOST_ONLY_REFERENCE_NOT_NATIVE_GUEST",
  "release_gate": "NOT_VERIFIED",
  "boundary": "trusted host -> tool-free model-data service; never a guest authority or a tool grant",
  "authority": "host callback must independently verify issuer, tenant, actor incarnation, epoch, revocation, expiration and permitted model data action; bool from guest, LLM or repository text is not evidence",
  "claim": "durable atomic one-shot claim keyed by tenant+actor+generation+epoch+revision+dispatch_id; payload SHA-256 immutable on first claim; no automatic replay on unknown result",
  "scope": [
    "tenant_id",
    "actor_id",
    "actor_generation",
    "activation_epoch",
    "exact_git_revision_sha1",
    "dispatch_id",
    "context_sha256",
    "expires_at_ms",
    "utf8_bytes",
    "measured_tokens"
  ],
  "constraints": {
    "tenant_actor_dispatch_ascii_max": 128,
    "git_sha1_lowercase_hex": 40,
    "context_sha256_lowercase_hex": 64,
    "generation_positive": true,
    "epoch_positive": true,
    "expiry_future_strict": true,
    "utf8_bytes_max": 65536,
    "measured_tokens_max": 16384,
    "tokenizer_host_owned": true
  },
  "required_sequence": [
    "host_construct_and_validate",
    "current_revision",
    "host_authorize",
    "atomic_durable_claim",
    "current_revision_recheck",
    "host_authorize_recheck",
    "submit_data_only_with_dispatch_id_and_digest"
  ],
  "negative_cases": [
    "missing_authorizer",
    "missing_claim_store",
    "wrong_tenant",
    "wrong_actor_generation",
    "stale_epoch",
    "wrong_revision",
    "expired",
    "zero_tokens",
    "over_token_budget",
    "over_byte_budget",
    "invalid_digest",
    "denied_authorization",
    "revoked_during_claim",
    "revision_changed_during_claim",
    "duplicate_dispatch",
    "concurrent_duplicate",
    "changed_payload_same_dispatch_id",
    "claim_storage_failure",
    "unknown_remote_outcome"
  ],
  "not_implemented": [
    "signed_capability_issuer",
    "production_key_rotation",
    "multi_host_linearizable_storage",
    "native_oreslang_actor_linkage",
    "host_to_provider_atomic_policy",
    "java_graal_guest_oracles",
    "llvm_guest_oracles",
    "wasm_guest_oracles",
    "net_native_aot_guest_oracles",
    "forge_guest_oracles",
    "cross_backend_trace_parity"
  ]
}
