// Experimental compiler checked iterative actor recursion v1.
// One pure recursive helper; no general nested, async or owned calls.
// An explicit opt-in wasm32 codegen gate owns 64 frames per instance.
fnc descend(int depth): int {
  return depth == 0 ? 0 : 1 + descend(depth - 1);
}

define actor BoundedCounter as {
  let total: int = 0;
  pub fnc on_message(int depth): int {
    return descend(depth);
  }
}

pub fnc main(): int {
  return 42;
}
