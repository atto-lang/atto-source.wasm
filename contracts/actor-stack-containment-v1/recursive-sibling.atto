// Proposed compiler-backed actor stack containment contract.
// NOT executable by current wasm32 scalar actor subset: nested fnc calls are
// fail-closed until checked actor-owned return/PC/operand frame lowering.
fnc descend(int depth): int {
  return depth == 0 ? 0 : 1 + descend(depth - 1);
}

define actor BoundedCounter as {
  let total: int = 0;
  pub fnc on_message(int depth): int {
    return descend(depth);
  }
}

pub fnc main(): int {
  return 42;
}
