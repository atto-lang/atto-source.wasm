// Minimal actual AttoLang guest SOURCE smoke: two opaque encoded-byte chunks,
// receiver-applied ACK, simulated disconnect, then replay the missing chunk.
// No socket, actor scheduling, FFmpeg, decoder, or codec behavior is claimed here.
// This file MUST be compiled and executed by each real AttoLang backend.
import class ReplayWindow from './replay_stream';
import fnc window from './replay_stream';

fnc verify(bool condition, String label): void {
  if !condition; do
    rt fail("VIDEO-REPLAY-FAIL|" + label);
  fi
  stdio.stdout.println("VIDEO-REPLAY-PASS|" + label);
}

fnc encoded_chunk(int first, int second): Array<int> {
  let mut Array<int> bytes = new Array<int>();
  bytes.add(first);
  bytes.add(second);
  return bytes;
}

pub routine main(): void {
  // Capacity 8 rather than 2 MiB keeps the very first guest gate minimal.
  let mut ReplayWindow replay = window(1, 8);
  verify(replay.capacity_bytes() == 8, "capacity");
  verify(replay.append(1, encoded_chunk(17, 18)).expect("first encoded chunk") == 2, "first-chunk");
  verify(replay.append(1, encoded_chunk(33, 34)).expect("second encoded chunk") == 4, "second-chunk");
  verify(replay.mark_sent(1, 4), "sent");
  // Only the first chunk is acknowledged as fully applied by the receiver.
  verify(replay.acknowledge(1, 2), "receiver-committed");
  // Network disconnect/reconnect is modeled by the recovered byte offset 2.
  let Array<int> missing = replay.replay_from(1, 2, 2).expect("resume missing chunk");
  verify(missing.size == 2 && missing.get(0) == 33 && missing.get(1) == 34, "resume-missing");
  verify(replay.replay_from(2, 2, 2).is_err(), "stale-generation-denied");
  stdio.stdout.println("VIDEO-REPLAY-SMOKE-DONE");
  return;
}
