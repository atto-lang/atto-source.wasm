    },
    {
      "id": "http-listen",
      "expect": "reject",
      "source": "pub fnc main():int{return http.listen(1);}"
    },
    {
      "id": "net-connect",
      "expect": "reject",
      "source": "pub fnc main():int{return net.connect(\"127.0.0.1\",1);}"
    },
    {
      "id": "net-connect-async",
      "expect": "reject",
      "source": "pub fnc main():int{return net.connect_async(\"127.0.0.1\",1);}"
    },
    {
      "id": "net-listen",
      "expect": "reject",
      "source": "pub fnc main():int{return net.listen(1);}"
