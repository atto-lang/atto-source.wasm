{
  "schemaVersion": 1,
  "policy": "native-async-only",
  "cases": [
    {
      "id": "pure",
      "expect": "accept",
      "source": "pub fnc main():int{return (5+3)*7-14;}"
    },
    {
      "id": "pure-io-comment",
      "expect": "accept",
      "source": "pub fnc main():int{return 42;} // fs.read_text_async http.get_async stdio.println legacy-blocking"
