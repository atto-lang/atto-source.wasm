    {
      "id": "fs-read",
      "expect": "reject",
      "source": "pub fnc main():int{return fs.read_text(\"/tmp/denied\");}"
    },
    {
      "id": "fs-read-blocking",
      "expect": "reject",
      "source": "pub fnc main():int{return fs.read_text_blocking(\"/tmp/denied\");}"
    },
    {
      "id": "fs-read-async",
      "expect": "reject",
      "source": "pub fnc main():int{return fs.read_text_async(\"/tmp/denied\");}"
    },
    {
      "id": "fs-write",
      "expect": "reject",
      "source": "pub fnc main():int{return fs.write_text(\"/tmp/denied\", \"x\");}"
    },
    {
      "id": "fs-write-async",
      "expect": "reject",
      "source": "pub fnc main():int{return fs.write_text_async(\"/tmp/denied\", \"x\");}"
    },
    {
      "id": "http-get",
