// Portable UDP denial/overflow/packet-count boundary vectors.
// Link independently with THIS backend's stdlib/net/udp.atto.
// 42 means all checks evaluated true at guest runtime; this file alone does
// not prove compiler import resolution, guest execution, or physical sockets.
pub fnc main(): int {
  if udp_stream_can_enqueue(0, 0, 0, 1, 1, 4) == false then return 1; fi
  if udp_stream_can_enqueue(1, 0, 0, 1, 1, 4) then return 2; fi
  if udp_stream_can_enqueue(0, 0, 0, 0, 1, 4) then return 3; fi
