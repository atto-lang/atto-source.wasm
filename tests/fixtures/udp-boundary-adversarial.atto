  if udp_stream_can_enqueue(0, 10, 0, 2, 10, 4) == false then return 9; fi
  if udp_stream_can_enqueue(0, 10, 1, 2, 10, 4) then return 10; fi
  if udp_stream_can_enqueue(1, 1, 2, 2, 3, 4) == false then return 11; fi
  if udp_stream_can_enqueue(1, 1, 3, 2, 3, 4) then return 12; fi
  if udp_stream_can_enqueue(1, 0, 0, 2, 1, 6) == false then return 13; fi
  if udp_stream_can_enqueue(0, 0, 65527, 1, 65527, 6) == false then return 14; fi
  if udp_stream_can_enqueue(0, 0, 65528, 1, 65535, 6) then return 15; fi
  if udp_stream_can_enqueue(0, 0, 65507, 1, 65535, 4) == false then return 16; fi
  if udp_stream_can_enqueue(0, 0, 65508, 1, 65535, 4) then return 17; fi
  if udp_stream_can_enqueue(0, 0, 0, 1, 1, 0) then return 18; fi
  if udp_stream_can_enqueue(0, 9223372036854775807, 1, 1, 9223372036854775807, 4) then return 19; fi
  if udp_stream_can_enqueue(0, 9223372036854775806, 1, 1, 9223372036854775807, 4) == false then return 20; fi
  if udp_stream_can_release(1, 0, 0) == false then return 21; fi
  if udp_stream_can_release(0, 0, 0) then return 22; fi
  if udp_stream_can_release(-1, 0, 0) then return 23; fi
  if udp_stream_can_release(1, -1, 0) then return 24; fi
  if udp_stream_can_release(1, 1, -1) then return 25; fi
  if udp_stream_can_release(1, 1, 2) then return 26; fi
  if udp_stream_can_release(2, 4, 4) == false then return 27; fi
  if udp_dropped_next(0) != 1 then return 28; fi
  if udp_dropped_next(2147483646) != 2147483647 then return 29; fi
  if udp_dropped_next(2147483647) != 2147483647 then return 30; fi
  if udp_dropped_next(-1) != -1 then return 31; fi
  if udp_send_to_admissible(4, 1, 0, 0, 0) == false then return 32; fi
  if udp_send_to_admissible(4, 0, 0, 0, 0) then return 33; fi
  if udp_send_to_admissible(6, 65535, 65527, 65527, 65527) == false then return 34; fi
  if udp_send_to_admissible(6, 65535, 65528, 65535, 65535) then return 35; fi
