// AttoLang std/env v1: Wasm32/Workers backend-owned .atto source candidate.
// STAGED ONLY: host env.get/env.has primitive + import linking not proven here.
// Browser and worker guests must receive a filtered immutable host-supplied environment map. Never implicitly map Node process.env, browser globals or worker options to guest permissions.
// Pure API semantics follow v1; no guest permissions granted by this file.
define module std_env as
  // An unset variable is None; a present empty string is Some("").
  // Permission denial and malformed names are errors, never None.
  pub fnc get(String name): Option<String> {
    return env.get(name);
  }

  pub fnc has(String name): bool {
    return env.has(name);
  }

  // A fallback is selected only for an absent key, not for an empty value.
  pub fnc get_or(String name, String fallback): String {
    return env.get(name).unwrap_or(fallback);
  }

  // Absence is an ordinary Result error; permission denial still propagates.
  pub fnc get_required(String name): Result<String, String> {
    val Option<String> value = env.get(name);
    if value.is_none(); do
      return Err("required environment variable is not set");
    fi
    return Ok(value.unwrap());
  }
  // Opt-in nonempty filtering: an empty present value becomes None.
  // This never converts permission denial into absence.
  pub fnc get_nonempty(String name): Option<String> {
    val Option<String> value = env.get(name);
    if value.is_none(); do
      return None;
    fi
    if value.unwrap() == ""; do
      return None;
    fi
    return value;
  }

  pub fnc get_required_nonempty(String name): Result<String, String> {
    val Option<String> value = get_nonempty(name);
    if value.is_none(); do
      return Err("required environment variable is absent or empty");
    fi
    return Ok(value.unwrap());
  }

  // Pure, strict conversion. Never log the input (it may contain secrets).
  // No locale, whitespace, case folding or permissive truthiness.
  pub fnc parse_bool(String raw): Result<bool, String> {
    if raw == "true" || raw == "1"; do
      return Ok(true);
    fi
    if raw == "false" || raw == "0"; do
      return Ok(false);
    fi
    return Err("invalid environment boolean");
  }

  // Unlike absence, a malformed present value is always an error.
  pub fnc get_bool(String name): Result<bool, String> {
    val Option<String> value = env.get(name);
    if value.is_none(); do
      return Err("required environment variable is not set");
    fi
    return parse_bool(value.unwrap());
  }

  pub fnc get_bool_or(String name, bool fallback): Result<bool, String> {
    val Option<String> value = env.get(name);
    if value.is_none(); do
      return Ok(fallback);
    fi
    return parse_bool(value.unwrap());
  }
end
