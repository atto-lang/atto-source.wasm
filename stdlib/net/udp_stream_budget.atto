// Backend-owned .atto budgeting layer for std.net.udp recv_stream.
// Account before enqueue, release on consumption/cancellation. This class
// does NOT carry a socket, buffer, or OS permission. The actor that owns the
// receive queue must serialize mutations; this is not a cross-actor lock.

define module UdpStream as
  pub define class Budget as
    let int max_packets;
    let int max_bytes;
    let mut int packets = 0;
    let mut int bytes = 0;
    let mut int dropped = 0;

    pub constructor(int max_packets, int max_bytes) {
      if max_packets < 1 || max_packets > 65536; do
        rt fail("UDP stream packet capacity must be 1..65536");
      fi
      if max_bytes < 1 || max_bytes > 16777216; do
        rt fail("UDP stream byte capacity must be 1..16777216");
      fi
      self.max_packets = max_packets;
      self.max_bytes = max_bytes;
    }

    // A zero-byte packet still consumes one packet slot.
    pub try_admit(mut self)(int payload_bytes): bool {
      if payload_bytes < 0; do return false; fi
      if payload_bytes > 65527; do return false; fi
      if self.packets >= self.max_packets; do
        self.record_drop();
        return false;
      fi
      if payload_bytes > self.max_bytes - self.bytes; do
        self.record_drop();
        return false;
      fi
      self.packets = self.packets + 1;
      self.bytes = self.bytes + payload_bytes;
      return true;
    }

    // Reject bogus or duplicate releases without corrupting accounting.
    pub release(mut self)(int payload_bytes): bool {
      if self.packets <= 0; do return false; fi
      if payload_bytes < 0; do return false; fi
      if payload_bytes > self.bytes; do return false; fi
      self.packets = self.packets - 1;
      self.bytes = self.bytes - payload_bytes;
      return true;
    }

    pub record_drop(mut self)(): void {
      if self.dropped < 2147483647; do
        self.dropped = self.dropped + 1;
      fi
    }

    pub queued_packets(): int { return self.packets; }
    pub queued_bytes(): int { return self.bytes; }
    pub dropped_packets(): int { return self.dropped; }
  end

  pub fnc budget(int max_packets, int max_bytes): Budget {
    return new Budget(max_packets, max_bytes);
  }
end
