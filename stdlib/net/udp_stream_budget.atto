// Backend-owned AttoLang UDP receive-stream queue budget.
// This object is actor-serialized state; not a cross-actor lock or socket.
// Invalid capacities are fail-closed: no packet is ever admitted. The host
// must still apply actor memory and NETWORK capabilities to real I/O.
define module UdpStream as
  define pub class Budget as
    mut int max_packets = 0;
    mut int max_bytes = 0;
    mut int packets = 0;
    mut int bytes = 0;
    mut int dropped = 0;

    constructor(int packet_limit, int byte_limit) {
      self.max_packets = packet_limit;
      self.max_bytes = byte_limit;
    }

    // Empty datagrams still consume one packet slot.
    // Use subtraction only after verifying current occupancy is in bounds.
    pub try_admit(int payload_bytes): bool {
      if self.max_packets < 1 then return false; fi
      if self.max_packets > 65536 then return false; fi
      if self.max_bytes < 1 then return false; fi
      if self.max_bytes > 16777216 then return false; fi
      if self.packets < 0 then return false; fi
      if self.bytes < 0 then return false; fi
      if payload_bytes < 0 then return false; fi
      if payload_bytes > 65527 then return false; fi
      if self.packets >= self.max_packets then
        self.record_drop();
        return false;
      fi
      if self.bytes > self.max_bytes then return false; fi
      if payload_bytes > self.max_bytes - self.bytes then
        self.record_drop();
        return false;
      fi
      self.packets = self.packets + 1;
      self.bytes = self.bytes + payload_bytes;
      return true;
    }

    // Release exactly one admitted datagram, never underflowing.
    pub release(int payload_bytes): bool {
      if self.packets <= 0 then return false; fi
      if self.bytes < 0 then return false; fi
      if payload_bytes < 0 then return false; fi
      if payload_bytes > self.bytes then return false; fi
      self.packets = self.packets - 1;
      self.bytes = self.bytes - payload_bytes;
      return true;
    }

    pub record_drop(): void {
      if self.dropped < 2147483647 then
        self.dropped = self.dropped + 1;
      fi
    }

    pub queued_packets(): int { return self.packets; }
    pub queued_bytes(): int { return self.bytes; }
    pub dropped_packets(): int { return self.dropped; }
  end

  pub fnc budget(int max_packets, int max_bytes): Budget {
    return new Budget(max_packets, max_bytes);
  }
end
