{
  "name": "@oreslang/source-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "compile:ores": "node scripts/compile-ores.mjs",
    "run:guest": "node scripts/run-guest.mjs",
    "test:real-compiler": "node scripts/verify-real-compiler.mjs",
    "test:real-aot": "node scripts/verify-real-aot.mjs",
    "test:refinement-admission": "node tests/refinement-admission-delegated.mjs",
    "test:mut-share": "ORESLANG_MUT_SHARE_PARITY_REQUIRED=1 node --test tests/rt-mut-share-source-parity.test.mjs",
    "test:macro-wasm32": "ORESLANG_MACRO_WASM_PARITY_REQUIRED=1 node --test tests/macro-scalar-wasm32-parity.test.mjs",
    "test:managed-pooled-actors": "node --test tests/actor-frame-stacks.test.mjs tests/actor-frame-stack-primordials.test.mjs tests/actor-frame-suspension-turn-fence.test.mjs tests/actor-arena.test.mjs tests/pooled-actor-frame-turn.test.mjs tests/pooled-managed-frame-worker.test.mjs tests/pooled-actors.test.mjs tests/actor-scalar-abi.test.mjs",
    "test:real-pooled-actors": "node scripts/verify-real-source-pooled-actor.mjs",
    "test:real-actor-guest-frames": "ATTO_REQUIRE_WASM_GUEST_FRAME=1 node --test tests/compiled-actor-guest-frame-m1.test.mjs",
    "test:real-wasm-actor-recursion": "ATTO_REQUIRE_REAL_ACTOR_RECURSION=1 node --test tests/checked-recursive-actor-v1.test.mjs",
    "test:supervised-pooled-actors": "node --test tests/supervised-pooled-actor-v1.test.mjs",
    "test:real-supervisor-guest": "ATTO_REQUIRE_REAL_SUPERVISOR_GUEST=1 node --test tests/supervised-pooled-actor-v1.test.mjs",
    "test:host-continuation-fence": "node --test tests/host-continuation-ticket-fence-v0.test.mjs"
  }
}
