// Compiled guest regression for pure std.fs byte I/O policy.
// Expected exit 42; any failure returns its own distinct positive exit code.
// This fixture has NO filesystem effects and does not certify std.fs admission.
pub fnc main(): int {
  if fs_io_next_chunk(0, 4, 9) != 0 then return 1; fi
  if fs_io_next_chunk(-1, 4, 9) != 0 then return 2; fi
  if fs_io_next_chunk(10, 0, 9) != 0 then return 3; fi
  if fs_io_next_chunk(10, 4, -1) != 0 then return 4; fi
