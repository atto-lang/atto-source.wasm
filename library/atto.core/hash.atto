// Wasm backend-local, noncryptographic octet hash step.
// No host JS hash, unchecked wrapping, OS, heap or random seed.
// This file alone does not authorize its import into a wasm32 guest.
define module hash as
  pub fnc initial_state(): int { return 17; }
  pub fnc step_byte(int state, int octet): int {
    if state < 0 || state >= 1000000007; do return -1; fi
    if octet < 0 || octet > 255; do return -1; fi
    let int candidate = state * 31 + octet;
    while candidate >= 1000000007 {
      candidate = candidate - 1000000007;
    }
    return candidate;
  }
  pub fnc two_bytes(int first, int second): int {
    let int head = step_byte(initial_state(), first);
    if head < 0; do return -1; fi
    return step_byte(head, second);
  }
  pub fnc from_bool(bool value): int {
    if value; do return step_byte(initial_state(), 1); fi
    return step_byte(initial_state(), 0);
  }
end
