// Wasm workers: never synthesize guest ADTs in JavaScript. Validate wasm32 guest artifacts, memory ownership and boundary ABI.
// Freestanding AttoLang Result adapters. Backend-owned source candidate.
// Result<T,E>/Ok/Err are nominal ADTs; Err is not a thrown exception.
// Match must consume at most one active payload with exact lifetime cleanup.
define module result as
  // Loan-only tag queries: never acquire or transfer an Ok/Err owner.
  // This is a compiler admission target, not proof that borrow generics lower.
  pub fnc is_ok_borrowed<T, E>(borrow Result<T, E> value): bool {
    return value.is_ok();
  }

  pub fnc is_err_borrowed<T, E>(borrow Result<T, E> value): bool {
    return value.is_err();
  }

  pub fnc flatten<T, E>(Result<Result<T, E>, E> value): Result<T, E> {
    return match value over
      on Ok(inner) -> inner,
      on Err(error) -> Err(error),
    end;
  }

  pub fnc map<T, U, E>(Result<T, E> value, Fnc<U(T)> transform): Result<U, E> {
    return match value over
      on Ok(item) -> Ok(transform(item)),
      on Err(error) -> Err(error),
    end;
  }

  pub fnc and_then<T, U, E>(
    Result<T, E> value, Fnc<Result<U, E>(T)> bind
  ): Result<U, E> {
    return match value over
      on Ok(item) -> bind(item),
      on Err(error) -> Err(error),
    end;
  }

  pub fnc map_err<T, E, F>(
    Result<T, E> value, Fnc<F(E)> transform
  ): Result<T, F> {
    return match value over
      on Ok(item) -> Ok(item),
      on Err(error) -> Err(transform(error)),
    end;
  }

  pub fnc or_else<T, E, F>(
    Result<T, E> value, Fnc<Result<T, F>(E)> recover
  ): Result<T, F> {
    return match value over
      on Ok(item) -> Ok(item),
      on Err(error) -> recover(error),
    end;
  }

  pub fnc to_option<T, E>(Result<T, E> value): Option<T> {
    return match value over
      on Ok(item) -> Some(item),
      on Err(_) -> None,
    end;
  }

  pub fnc transpose<T, E>(Result<Option<T>, E> value): Option<Result<T, E>> {
    return match value over
      on Ok(inner) -> match inner over
        on Some(item) -> Some(Ok(item)),
        on None -> None,
      end,
      on Err(error) -> Some(Err(error)),
    end;
  }
end
